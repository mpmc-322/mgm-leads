# Copy to .env and `set -a; source .env; set +a` before running locally.
# In GitHub Actions these are repo secrets instead (see .github/workflows/bt-sync.yml).
# NEVER commit the real .env or storageState.json — both are gitignored.

# --- Buildertrend ---
BT_BASE_URL=https://buildertrend.net
BT_NEW_LEAD_PATH=/app/leads/opportunities   # Lead Opportunities list; the modal is opened from here
BT_USERNAME=                 # only used by `npm run login`
BT_PASSWORD=                 # only used by `npm run login`
DEFAULT_SALESPERSON=         # BT salesperson name, or leave blank for unassigned

# --- The lead to push (JSON). In CI the workflow injects client_payload.lead here. ---
# Locally, set a sample for dry runs, e.g.:
#   BT_LEAD_JSON='{"first_name":"Test","last_name":"Lead","email":"t@example.com","phone":"207-555-0100","project_type":"new_build","land_status":"owns","location_street":"1 Main St","location_town":"Brunswick","location_zip":"04011","budget_range":"750k-1m","timeline":"3_6mo","referral_source":"google","vision":"A test build."}'
BT_LEAD_JSON=

# --- Alerts: set ONE channel ---
ALERT_SLACK_WEBHOOK=
# or EmailJS (server-side send needs the PRIVATE key):
ALERT_EMAIL_TO=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Local run options ---
STORAGE_STATE_PATH=./storageState.json
# DRY_RUN=1   # fill the form but stop before Save, leave browser open
